<UserControl x:Class="ACViewer.View.ClothingTableList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ACViewer.ViewModels"
             xmlns:local="clr-namespace:ACViewer.View">
    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type vm:BaseEffectVM}" ItemsSource="{Binding SubPaletteEffects}">
            <TextBlock Text="{Binding DisplayName}" />
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type vm:SubPaletteEffectVM}" ItemsSource="{Binding CloSubPalettes}">
            <TextBlock Text="{Binding DisplayName}" />
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type vm:CloSubPaletteVM}" ItemsSource="{Binding Ranges}">
            <TextBlock Text="{Binding DisplayName}" />
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type vm:RangeVM}">
            <TextBlock Text="{Binding DisplayName}" />
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="210" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.ColumnSpan="1" Margin="2,2,2,4">
            <WrapPanel x:Name="ToolbarWrap" Orientation="Horizontal" ItemHeight="24" ItemWidth="Auto">
                <Button Margin="0,0,4,4" Command="{Binding NewClothingCommand}"><TextBlock Text="New"/></Button>
                <Button Margin="0,0,4,4" Command="{Binding CloneClothingCommand}"><TextBlock Text="Clone"/></Button>
                <Button Margin="0,0,4,4" Click="AssignClothingId_Click" ToolTip="Assign a suggested free ClothingMod ID or intentionally override an existing ID"><TextBlock Text="Assign ID"/></Button>
                <Button Margin="0,0,4,4" Command="{Binding DeleteClothingCommand}"><TextBlock Text="Delete"/></Button>
                <Button Margin="0,0,4,4" Width="34" Command="{Binding IncreaseScaleCommand}"><TextBlock Text="A+"/></Button>
                <Button Margin="0,0,4,4" Width="34" Command="{Binding DecreaseScaleCommand}"><TextBlock Text="A-"/></Button>
            </WrapPanel>
        </DockPanel>

        <!-- Main content (previously left pane only). The removed right editor is now provided exclusively by popup dialog. -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" Margin="4,0,4,4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Stretch">
                <Expander IsExpanded="True" Header="Studio Workflow" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="{Binding Workflow.Project.Summary}" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Workflow.Issues}" Margin="0,0,0,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" FontSize="10" Opacity="0.82" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>                        <ItemsControl ItemsSource="{Binding Workflow.Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsComplete}" IsHitTestVisible="False" Focusable="False" VerticalAlignment="Top" Margin="0,1,6,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Hint}" Opacity="0.72" FontSize="10" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>                <Expander IsExpanded="True" Header="Working Clothing Mods" Margin="0,0,0,4">
                    <ListBox ItemsSource="{Binding ClothingItems}" SelectedItem="{Binding SelectedClothing}" DisplayMemberPath="DisplayName" Height="150" SelectionChanged="ClothingItems_SelectionChanged" />
                </Expander>
                <Expander IsExpanded="True" Header="Setup &amp; Palettes" Margin="0,0,0,4">
                    <StackPanel>
                        <ListBox Name="SetupIds" Margin="0,4,0,0" SelectionChanged="SetupIDs_OnClick" Height="100"/>
                        <ListBox Name="PaletteTemplates" Margin="0,4,0,0" SelectionChanged="PaletteTemplates_OnClick" Height="140" />
                        <Slider Name="Shades" Margin="0,4,0,0" IsEnabled="False" ValueChanged="Shades_ValueChanged" SmallChange="1" IsSnapToTickEnabled="True" />
                        <Label x:Name="lblShade" Content="Shade: 0" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                        <Button Content="Import JSON..." Margin="0,6,0,0" Click="BtnImportJson_Click" />
                    </StackPanel>
                </Expander>
                <Expander IsExpanded="True" Header="Effects Tree" Margin="0,0,0,4">
                    <TreeView ItemsSource="{Binding SelectedClothing.BaseEffects}" SelectedItemChanged="Tree_SelectedItemChanged" Height="300" />
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="1" Margin="4" Foreground="Gray" FontSize="10" Text="Palette and texture editing opens in the docked Custom Palette panel."/>
    </Grid>
</UserControl>
